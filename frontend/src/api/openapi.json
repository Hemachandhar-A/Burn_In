    "/lots/{lot_id}/quality": {
      "get": {
        "description": "E7 step 7, surfaced separately from `LotUploadResponse` - that response model is frozen\n(`contracts.py`) with no field for quality flags; logged in CONTRACT_CHANGES.md rather than\nhand-edited. Not a contract type itself, so no `response_model` - plain JSON.",
        "operationId": "get_quality_flags_lots__lot_id__quality_get",
        "parameters": [
          {
            "in": "path",
            "name": "lot_id",
            "required": true,
            "schema": {
              "title": "Lot Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
